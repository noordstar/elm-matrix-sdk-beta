module Matrix.Types.StrippedStateEvent exposing
    ( StrippedStateEvent, content, eventType, stateKey, sender
    , decoder
    )

{-|


# Stripped state events

Sometimes, the Matrix API has a LOT of state events to share. Stripped state
events are stripped down where they no longer contain any metadata. This makes
payloads significantly smaller.

@docs StrippedStateEvent, content, eventType, stateKey, sender


## JSON

@docs decoder

-}

import Json.Decode as D
import Matrix.Types.UserId as UserId exposing (UserId)


{-| Stripped state events offer a simplified view of the state of a room.

In JSON form, they look similar to this:

    {
        "content": { "body": "Hello, world!" },
        "sender": "@alice:example.org",
        "state_key": "",
        "type": "org.example.room_description"
    }

These are the only four fields the stripped state event can have.

-}
type StrippedStateEvent
    = StrippedStateEvent
        { content : D.Value
        , sender : UserId
        , stateKey : String
        , type_ : String
        }


{-| Custom content containing information about the room's state.

Keep in mind that this JSON content is often generated by other users, such as
moderators.

-}
content : StrippedStateEvent -> D.Value
content (StrippedStateEvent e) =
    e.content


{-| Decodes a stripped state event from JSON.
-}
decoder : D.Decoder StrippedStateEvent
decoder =
    D.map4
        (\c se sk et ->
            StrippedStateEvent
                { content = c
                , sender = se
                , stateKey = sk
                , type_ = et
                }
        )
        (D.field "content" D.value)
        (D.field "sender" UserId.decoder)
        (D.field "state_key" D.string)
        (D.field "type" D.string)


{-| Event type in string format. This value gives a hint about the content to
decode.
-}
eventType : StrippedStateEvent -> String
eventType (StrippedStateEvent e) =
    e.type_


{-| The user who originally uploaded this version of the stripped state event.
-}
sender : StrippedStateEvent -> UserId
sender (StrippedStateEvent e) =
    e.sender


{-| An identifier for the stripped state event. For each room, the tuple
`(eventType, stateKey)` is unique.
-}
stateKey : StrippedStateEvent -> String
stateKey (StrippedStateEvent e) =
    e.stateKey
