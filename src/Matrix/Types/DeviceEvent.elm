module Matrix.Types.DeviceEvent exposing
    ( DeviceEvent
    , content, eventType, sender
    , decoder
    )

{-| The Matrix API allows messages to be exchanged directly between clients
without having the messages be stored on the timeline. This is usually used to
exchange end-to-end encryption keys or other secrets.

@docs DeviceEvent

Although it makes little sense, the specification does not require the
`DeviceEvent` type to contain any information whatsoever. For this reason,
unfortunately, all information extracted is held behind a `Maybe` type.

@docs content, eventType, sender


## JSON

@docs decoder

-}

import Internal.Tools.DecodeExtra as DE
import Json.Decode as D
import Matrix.Types.UserId as UserId exposing (UserId)


{-| The DeviceEvent is an event that was passed specifically towards this
device. If you have this type, it is very likely that the Matrix server has
already deleted the message on its end.
-}
type DeviceEvent
    = DeviceEvent
        { content : Maybe D.Value
        , sender : Maybe UserId
        , type_ : Maybe String
        }


{-| Extracts the `DeviceEvent` content. This is a JSON generated by the other
user, not by the server.
-}
content : DeviceEvent -> Maybe D.Value
content (DeviceEvent data) =
    data.content


{-| Defines how to decode the `DeviceEvent` type properly.
-}
decoder : D.Decoder DeviceEvent
decoder =
    D.map3 (\c s t -> DeviceEvent { content = c, sender = s, type_ = t })
        (DE.opField "content" D.value)
        (DE.opField "sender" UserId.decoder)
        (DE.opField "type" D.string)


{-| Extracts the event's event type. This string offers a hint about how to
decode the event content.
-}
eventType : DeviceEvent -> Maybe String
eventType (DeviceEvent data) =
    data.type_


{-| Extracts the user id that sent the message to this device.
-}
sender : DeviceEvent -> Maybe UserId
sender (DeviceEvent data) =
    data.sender
